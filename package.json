{
  "name": "cook-meal-planner",
  "version": "1.0.0",
  "description": "A full-stack weekly meal planner with recipe discovery and AI nutrition estimates.",
  "private": true,
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon app.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:frontend": "npm ci --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run install:frontend && npm run build:frontend",
    "lint": "npm run lint --prefix frontend",
    "check:backend": "find api server db -name '*.js' -print0 | xargs -0 -n1 node --check && node --check app.js",
    "check": "npm run check:backend && npm run lint && npm run build:frontend",
    "start": "node app.js"
  },
  "author": "monishpatalay (https://github.com/monishpatalay)",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monishpatalay/Meal-Planner-AI-App.git"
  },
  "bugs": {
    "url": "https://github.com/monishpatalay/Meal-Planner-AI-App/issues"
  },
  "homepage": "https://github.com/monishpatalay/Meal-Planner-AI-App#readme",
  "keywords": [
    "meal-planner",
    "nutrition",
    "react",
    "express",
    "mongodb"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.60",
    "ai": "^6.0.226",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "node-fetch": "^3.3.2",
    "stripe": "^22.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.7"
  }
}
